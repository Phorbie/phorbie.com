/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Images: cached for a week, since they are still being swapped under the same names.
/img/*
  Cache-Control: public, max-age=604800

# Fonts, 3D files and vendor scripts are cached for a year.
# If you replace one of these, give it a new name (for example ilet-case.v3.glb) so visitors get the new copy.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
